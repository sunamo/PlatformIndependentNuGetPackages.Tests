<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>CS8632;CS1998;CS0162;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.0" />
    <PackageReference Include="SunamoUwpApps" Version="26.10.3.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sources that were never compiled in the original test projects (helpers for manual runs inside a UWP app). -->
    <Compile Remove="Linked\ProtectedDataTestsShared.cs" />
    <None Include="Linked\ProtectedDataTestsShared.cs" />
    <Compile Remove="_legacy\**" />
    <None Include="_legacy\**" />
  </ItemGroup>
</Project>
